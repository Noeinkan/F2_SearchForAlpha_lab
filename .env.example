# SearchForAlpha environment variables. Copy to .env and fill in.
# Never commit .env. The values below are examples, not real credentials.

# Interactive Brokers Gateway connection (paper port is 4002, live is 4001).
# The CLI refuses --mode live regardless of these values.
SFA_IB_HOST=127.0.0.1
SFA_IB_PORT=4002
SFA_IB_CLIENT_ID=7

# Optional: override the default sqlite path used by Optuna and sfa stores.
SFA_STATE_DB=state/optuna.db

# Optional: structlog level (DEBUG, INFO, WARNING, ERROR).
SFA_LOG_LEVEL=INFO
