# SearchForAlpha environment variables. Copy to .env and fill in.
# Never commit .env. The values below are examples, not real credentials.

# Interactive Brokers Gateway connection (paper port is 4002, live is 4001).
# The CLI refuses --mode live regardless of these values.
SFA_IB_HOST=127.0.0.1
SFA_IB_PORT=4002
SFA_IB_CLIENT_ID=7

# Optional: override the default sqlite path used by Optuna and sfa stores.
SFA_STATE_DB=state/optuna.db

# Optional: structlog level (DEBUG, INFO, WARNING, ERROR).
SFA_LOG_LEVEL=INFO

# --- Public demo (python -m demo.server; see docs/DEMO.md) --------------------
# Kill switch. Unset or false: every page 404s and the dashboard is not loaded.
# DEMO_MODE=false
# DEMO_HOST=127.0.0.1
# DEMO_PORT=8050
# DEMO_THREADS=8
# DEMO_MAX_SESSIONS=60
# DEMO_SESSION_IDLE_MINUTES=30
# DEMO_MAX_COMBOS=150
# DEMO_MAX_SIGNALS_PER_SIDE=2
# DEMO_MAX_GRID_COMBOS=250
# DEMO_MAX_BAYES_TRIALS=30
# DEMO_OPTIMIZER_WORKERS=2
# DEMO_MAX_CONCURRENT_JOBS=2
# DEMO_JOB_TIMEOUT_SECONDS=120
# DEMO_ACTIONS_PER_IP_PER_MINUTE=30
# DEMO_JOBS_PER_IP_PER_HOUR=20
# Email gate, trial and usage log (demo/access/). false opens the demo to anyone, unrecorded.
# DEMO_ACCESS_GATE=true
# DEMO_ACCESS_DB=state/demo-access/access.sqlite3
# DEMO_TRIAL_DAYS=7
# DEMO_JOBS_PER_EMAIL_PER_DAY=25
# DEMO_RETENTION_DAYS=365
# DEMO_CODE_MINUTES=15
# DEMO_CODE_ATTEMPTS=5
# DEMO_CODES_PER_EMAIL_PER_HOUR=3
# DEMO_CODES_PER_HOUR=60
# DEMO_SIGNUPS_PER_IP_PER_DAY=5
# DEMO_BLOCKED_EMAIL_DOMAINS=
# DEMO_PUBLIC_URL=
# DEMO_CONTACT_EMAIL=
# smtp sends the sign-in email; console prints it in the terminal (local runs).
# DEMO_MAIL_BACKEND=smtp
# DEMO_SMTP_HOST=
# DEMO_SMTP_PORT=587
# DEMO_SMTP_SECURITY=starttls
# DEMO_SMTP_USER=
# DEMO_SMTP_PASSWORD=
# DEMO_MAIL_FROM=SearchForAlpha Lab <demo@example.com>
# At least 24 characters, or /admin is a 404.
# DEMO_ADMIN_TOKEN=
